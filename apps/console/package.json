{
	"name": "@ab-tao/console",
	"version": "0.3.1",
	"description": "ab-tao 後台控制台 — Vue 3 + Element Plus + ECharts",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=18",
		"pnpm": ">=9"
	},
	"scripts": {
		"dev": "node scripts/start.mjs",
		"build": "vue-tsc --noEmit && vite build",
		"preview": "vite preview",
		"open": "node scripts/start.mjs --open",
		"serve": "node server/index.mjs",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "biome check ."
	},
	"dependencies": {
		"@element-plus/icons-vue": "^2.3.2",
		"echarts": "^5.6.0",
		"element-plus": "^2.9.9",
		"pinia": "^3.0.2",
		"vue": "^3.5.13",
		"vue-echarts": "^7.0.3",
		"vue-router": "^4.5.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.10",
		"@types/node": "^22.15.3",
		"@vitejs/plugin-vue": "^5.2.3",
		"@vue/test-utils": "^2.4.6",
		"concurrently": "^9.1.2",
		"jsdom": "^26.1.0",
		"typescript": "^5.8.3",
		"unplugin-auto-import": "^19.1.2",
		"unplugin-vue-components": "^28.5.0",
		"vite": "^6.3.3",
		"vitest": "^3.1.2",
		"vue-tsc": "^2.2.10"
	}
}
