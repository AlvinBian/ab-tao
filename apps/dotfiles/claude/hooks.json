{
	"description": "ab-tao hooks：檔案保護、危險命令攔截、macOS 通知",
	"hooks": {
		"SessionStart": [
			{
				"id": "ab-tao:session:inject-project-prompt",
				"matcher": "",
				"hooks": [
					{
						"type": "command",
						"command": "$HOME/.claude/hooks/inject-project-prompt.sh",
						"timeout": 3
					}
				]
			}
		],
		"PreToolUse": [
			{
				"id": "ab-tao:pre:protect-files",
				"matcher": "Edit|Write",
				"hooks": [
					{
						"type": "command",
						"command": "$HOME/.claude/hooks/protect-files.sh",
						"timeout": 5
					},
					{
						"type": "command",
						"command": "$HOME/.claude/hooks/validate-memory-path.sh",
						"timeout": 5
					}
				]
			},
			{
				"id": "ab-tao:pre:block-dangerous",
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "$HOME/.claude/hooks/block-dangerous.sh",
						"timeout": 5
					}
				]
			}
		],
		"Notification": [
			{
				"id": "ab-tao:notification:hook-handler",
				"matcher": "",
				"hooks": [
					{
						"type": "command",
						"command": "$HOME/.claude/hooks/hook-handler.sh",
						"timeout": 5
					}
				]
			}
		],
		"PreCompact": [
			{
				"id": "ab-tao:pre-compact:hook-handler",
				"matcher": "auto",
				"hooks": [
					{
						"type": "command",
						"command": "$HOME/.claude/hooks/hook-handler.sh",
						"timeout": 5
					}
				]
			}
		],
		"PermissionDenied": [
			{
				"id": "ab-tao:permission-denied:hook-handler",
				"matcher": "",
				"hooks": [
					{
						"type": "command",
						"command": "$HOME/.claude/hooks/hook-handler.sh",
						"timeout": 5
					}
				]
			}
		],
		"Stop": [
			{
				"id": "ab-tao:stop:hook-handler",
				"matcher": "",
				"hooks": [
					{
						"type": "command",
						"command": "$HOME/.claude/hooks/hook-handler.sh",
						"timeout": 10
					}
				]
			},
			{
				"id": "ab-tao:stop:relocate-plan",
				"matcher": "",
				"hooks": [
					{
						"type": "command",
						"command": "$HOME/.claude/hooks/relocate-plan.sh",
						"timeout": 5
					}
				]
			}
		],
		"SessionEnd": [
			{
				"id": "ab-tao:session-end:hook-handler",
				"matcher": "",
				"hooks": [
					{
						"type": "command",
						"command": "$HOME/.claude/hooks/hook-handler.sh",
						"timeout": 10
					}
				]
			},
			{
				"id": "ab-tao:session-end:relocate-plan",
				"matcher": "",
				"hooks": [
					{
						"type": "command",
						"command": "$HOME/.claude/hooks/relocate-plan.sh",
						"timeout": 5
					}
				]
			}
		],
		"TaskCompleted": [
			{
				"id": "ab-tao:task-completed:hook-handler",
				"matcher": "",
				"hooks": [
					{
						"type": "command",
						"command": "$HOME/.claude/hooks/hook-handler.sh",
						"timeout": 5
					}
				]
			}
		],
		"SubagentStop": [
			{
				"id": "ab-tao:subagent-stop:hook-handler",
				"matcher": "",
				"hooks": [
					{
						"type": "command",
						"command": "$HOME/.claude/hooks/hook-handler.sh",
						"timeout": 5
					}
				]
			}
		],
		"PostToolUseFailure": [
			{
				"id": "ab-tao:post-tool-use-failure:hook-handler",
				"matcher": "",
				"hooks": [
					{
						"type": "command",
						"command": "$HOME/.claude/hooks/hook-handler.sh",
						"timeout": 5
					}
				]
			}
		]
	}
}
