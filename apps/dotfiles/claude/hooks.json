{
	"description": "ab-tao hooks：檔案保護、危險命令攔截、macOS 通知",
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Edit|Write",
				"hooks": [
					{
						"type": "command",
						"command": "$HOME/.claude/hooks/pretooluse-protect-files.sh",
						"timeout": 5
					}
				]
			},
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "$HOME/.claude/hooks/pretooluse-block-dangerous.sh",
						"timeout": 5
					}
				]
			}
		],
		"Notification": [
			{
				"matcher": "",
				"hooks": [
					{
						"type": "command",
						"command": "$HOME/.claude/hooks/notify.sh",
						"timeout": 5
					}
				]
			}
		],
		"PreCompact": [
			{
				"matcher": "auto",
				"hooks": [
					{
						"type": "command",
						"command": "$HOME/.claude/hooks/notify.sh",
						"timeout": 5
					}
				]
			}
		],
		"PermissionDenied": [
			{
				"matcher": "",
				"hooks": [
					{
						"type": "command",
						"command": "$HOME/.claude/hooks/notify.sh",
						"timeout": 5
					}
				]
			}
		],
		"Stop": [
			{
				"matcher": "",
				"hooks": [
					{
						"type": "command",
						"command": "$HOME/.claude/hooks/notify.sh",
						"timeout": 10
					}
				]
			}
		],
		"SessionEnd": [
			{
				"matcher": "",
				"hooks": [
					{
						"type": "command",
						"command": "$HOME/.claude/hooks/notify.sh",
						"timeout": 10
					}
				]
			}
		],
		"TaskCompleted": [
			{
				"matcher": "",
				"hooks": [
					{
						"type": "command",
						"command": "$HOME/.claude/hooks/notify.sh",
						"timeout": 5
					}
				]
			}
		],
		"SubagentStop": [
			{
				"matcher": "",
				"hooks": [
					{
						"type": "command",
						"command": "$HOME/.claude/hooks/notify.sh",
						"timeout": 5
					}
				]
			}
		],
		"PostToolUseFailure": [
			{
				"matcher": "",
				"hooks": [
					{
						"type": "command",
						"command": "$HOME/.claude/hooks/notify.sh",
						"timeout": 5
					}
				]
			}
		]
	}
}
