{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"hooks": {
		"SessionStart": [
			{
				"id": "ab-tao:session:start",
				"description": "專案提醒注入 + 冷啟動 briefing + config drift 偵測",
				"hooks": [
					{
						"type": "command",
						"command": "$HOME/.claude/hooks/session-start.sh",
						"timeout": 8
					}
				]
			}
		],
		"PreToolUse": [
			{
				"id": "ab-tao:pre:bash",
				"description": "危險命令攔截（sudo rm / rm -rf / fork bomb / curl|bash 等）",
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "$HOME/.claude/hooks/pre-tool-bash.sh",
						"timeout": 5
					}
				]
			},
			{
				"id": "ab-tao:pre:edit",
				"description": "檔案保護 + Memory 路徑自動校驗 + MEMORY.md 配額警告",
				"matcher": "Edit|Write|MultiEdit",
				"hooks": [
					{
						"type": "command",
						"command": "$HOME/.claude/hooks/pre-tool-edit.sh",
						"timeout": 5
					}
				]
			}
		],
		"PreCompact": [
			{
				"id": "ab-tao:pre-compact",
				"description": "定向壓縮指令注入（保留核心需求 / 犧牲調試輸出）",
				"hooks": [
					{
						"type": "command",
						"command": "$HOME/.claude/hooks/pre-compact.sh",
						"timeout": 5
					}
				]
			}
		],
		"PostToolUse": [
			{
				"id": "ab-tao:post-tool",
				"description": "Memory 索引觸發（Phase 13 預留接口）",
				"hooks": [
					{
						"type": "command",
						"command": "$HOME/.claude/hooks/post-tool.sh",
						"timeout": 5
					}
				]
			}
		],
		"Stop": [
			{
				"id": "ab-tao:stop",
				"description": "macOS 匯總通知 + 會話評估",
				"hooks": [
					{
						"type": "command",
						"command": "$HOME/.claude/hooks/stop.sh",
						"timeout": 10
					}
				]
			}
		],
		"SessionEnd": [
			{
				"id": "ab-tao:session:end",
				"description": "Plan 歸位 + Memory decay scan + flush 通知 + 舊備份清理",
				"hooks": [
					{
						"type": "command",
						"command": "$HOME/.claude/hooks/session-end.sh",
						"timeout": 10
					}
				]
			}
		]
	}
}
