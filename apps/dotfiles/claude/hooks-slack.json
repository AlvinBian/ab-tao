{
	"description": "Slack session 通知（僅在 slack feature 啟用時合併）",
	"hooks": {
		"SessionStart": [
			{
				"matcher": "",
				"hooks": [
					{
						"type": "command",
						"command": "$HOME/.claude/hooks/slack-dispatch.sh session-start",
						"timeout": 3
					}
				]
			}
		],
		"Stop": [
			{
				"matcher": "",
				"hooks": [
					{
						"type": "command",
						"command": "$HOME/.claude/hooks/slack-dispatch.sh session-stop",
						"timeout": 3
					}
				]
			}
		]
	}
}
