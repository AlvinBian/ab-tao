{
	"id": "ab-tao:voice-trigger",
	"name": "Voice Trigger — 中文意圖前置轉換",
	"description": "UserPromptSubmit 中文關鍵字 → 命令前置（voiceTrigger 開關控制）",
	"scripts": ["user-prompt-submit-voice.sh"],
	"hooks": [
		{
			"event": "UserPromptSubmit",
			"hooks": [
				{
					"type": "command",
					"command": "bash $HOME/.claude/hooks/user-prompt-submit-voice.sh"
				}
			]
		}
	],
	"enabled": false,
	"tier": "hook",
	"feature": "voice-trigger"
}
