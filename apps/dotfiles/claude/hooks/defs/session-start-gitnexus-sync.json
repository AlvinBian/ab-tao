{
  "event": "SessionStart",
  "hooks": [
    {
      "id": "ab-tao:gitnexus:sync",
      "description": "偵測 GitNexus 索引落後 HEAD → 背景靜默重建（--index-only，節流，非阻塞）",
      "hooks": [
        {
          "type": "command",
          "command": "bash $HOME/.claude/hooks/gitnexus-sync.sh",
          "timeout": 8
        }
      ]
    }
  ]
}
