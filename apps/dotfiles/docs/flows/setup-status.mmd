flowchart TD
    Entry([從主流程進入]) --> Health["配置健康度<br/>85% 42/50"]

    Health --> Claude["Claude 配置<br/>Commands 4 個 check, slack, test, db-migration<br/>Agents 2 個 architect, debugger<br/>Rules 1 個 api-and-data<br/>Hooks 5 個 prettier, eslint, file-protection, dangerous-command-block, macos-notification<br/>CLAUDE.md 4 個 repo"]

    Claude --> ZshInfo["ZSH 模組<br/>~/.zshrc.d/ + sheldon 插件管理"]

    ZshInfo --> SlackInfo["Slack 通知<br/>模式：Channel #xxx"]

    SlackInfo --> AiInfo["AI 設定<br/>模型：sonnet"]

    AiInfo --> Select{"選擇調整項目"}

    Select -->|"Claude 配置 commands 4 agents 2 rules 1"| AClaude
    Select -->|"全局設定 settings"| ASettings
    Select -->|"CLAUDE.md 4 個 repo 需 AI"| AClaudeMd
    Select -->|"ZSH 模組 ~/.zshrc.d/"| AZsh
    Select -->|"Slack 通知 channel"| ASlack
    Select -->|"返回"| Exit([已取消])

    subgraph AClaude ["adjustClaude"]
        AC1["備份 commands/agents/rules"] --> AC2["smartSelect 重選"]
        AC2 --> AC3["生成 preview"] --> AC4["執行安裝腳本"]
        AC4 --> AC5["patchSession"]
    end

    subgraph ASettings ["adjustGlobalSettings"]
        AS1["讀取 settings-template.json"]
        AS1 --> AS2["deploySettings smart merge<br/>只添加新 permissions，不刪除現有"]
        AS2 --> AS3["patchSession"]
    end

    subgraph AClaudeMd ["adjustClaudeMd"]
        CM1{"session 有 repos?"}
        CM1 -->|No| CMW["提示重新 setup"] --> Done
        CM1 -->|Yes| CM2["AI 確認（約 30 秒）"]
        CM2 --> CM3["generateClaudeMd x N repos"]
        CM3 --> CM4["deployAllProjectClaudeMd"]
        CM4 --> CM5["patchSession"]
    end

    subgraph AZsh ["adjustZsh"]
        AZ1["備份 ~/.zshrc.d/"]
        AZ1 --> AZ2["smartSelect 重選模組"]
        AZ2 --> AZ3["生成 preview"] --> AZ4["執行安裝腳本<br/>loader 追加至 .zshrc"]
        AZ4 --> AZ5["patchSession"]
    end

    subgraph ASlack ["adjustSlack"]
        SK1["setupSlackNotify 互動設定"]
        SK1 --> SK2["Channel / DM / 關閉"]
        SK2 --> SK3["patchSession"]
    end

    AClaude --> Done([調整完成])
    ASettings --> Done
    AClaudeMd -.-> Done
    AZsh --> Done
    ASlack --> Done

    classDef decision fill:#d29922,color:#000,stroke:#d29922
