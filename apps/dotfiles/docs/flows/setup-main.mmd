---
title: 主流程 — pnpm run d:setup
description: 入口分支 → 功能選擇 → 3 步安裝 → 完成
links:
  - phase-execute: 安裝執行
  - env-check: 環境檢查
---
flowchart TD
    Start(["pnpm run d:setup"]) --> Init["載入 config.json + session<br/>解析 CLI flags"]

    Init --> QuickCheck{"--quick?"}

    %% ── 快速重裝 ──
    QuickCheck -->|Yes| QSession{"有 session?"}
    QSession -->|No| QError([錯誤退出])
    QSession -->|Yes| QRun["runQuickInstall<br/>用上次設定直接執行"]
    QRun --> Complete

    %% ── 有 session 重入 ──
    QuickCheck -->|No| PrevCheck{"有 session?"}
    PrevCheck -->|No| Fresh
    PrevCheck -->|Yes| Reentry

    subgraph Reentry ["重入選單"]
        RMenu{"選擇操作"}
        RMenu -->|"🔄 重新安裝"| RQuick["runQuickInstall"]
        RMenu -->|"⚙️ 調整設定"| RAdjust["清除 org → 完整流程"]
        RMenu -->|"📊 查看配置"| RStatus["status 儀表板"]
        RMenu -->|"📋 查看報告"| RReport["開啟 HTML"]
    end

    RQuick --> Complete
    RAdjust --> Fresh
    RStatus --> End([結束])
    RReport --> End

    %% ── 完整安裝 ──
    subgraph Fresh ["完整安裝流程"]
        F1["🔍 環境檢查<br/>brew · nvm · node · pnpm · gh · claude"]
        F1 --> F2["功能選擇<br/>Claude · 專案 · ZSH · Slack"]
        F2 --> F3["AI 來源選擇<br/>ECC + commons 同步"]
        F3 --> F4{"has Slack?"}
        F4 -->|Yes| F5["Slack 通知設定"]
        F4 -->|No| Loop
        F5 --> Loop
    end

    subgraph Loop ["3 步安裝（支持 BACK）"]
        L1["Step 1: 選擇倉庫<br/>多組織 + 貢獻度預選"]
        L1 --> L2["角色分類<br/>⭐主力 · 🔄臨時 · 🔧工具"]
        L2 --> L3["phaseAnalyze<br/>AI 技術棧偵測"]
        L3 --> L4["Step 2: 確認計畫"]
        L4 --> L5["Step 3: phaseExecute<br/>並行安裝 →"]
    end

    L5 --> Complete

    subgraph Complete ["完成"]
        C1["安裝摘要"]
        C1 --> C2["快速上手引導"]
        C2 --> C3["💡 三層推薦（Token/Plugins/增強）"]
        C3 --> C4["HTML 報告"]
        C4 --> C5["Session 保存"]
    end

    C5 --> End

    classDef decision fill:#d29922,color:#000
    classDef action fill:#1f6feb,color:#fff
    classDef success fill:#238636,color:#fff

    class QuickCheck,PrevCheck,QSession,F4,RMenu decision
    class F1,F2,F3,F5,L1,L2,L3,L4,L5 action
    class C1,C2,C3,C4,C5 success
