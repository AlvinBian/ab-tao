# ab-tao 環境變數範本
# 複製此檔為 .env.local（不 commit），填入實際值。

# ── claude-context：語義代碼搜尋 ─────────────────────────────────
# ⚠️  LM Studio 為非官方路線；官方驗證路線請改用 Ollama（EMBEDDING_PROVIDER=Ollama）
# 啟動 LM Studio → 載入 nomic-embed-text-v2-moe → 啟動 Local Server (port 1234)
CLAUDE_CONTEXT_PROVIDER=OpenAI
CLAUDE_CONTEXT_MODEL=nomic-embed-text-v2-moe
CLAUDE_CONTEXT_API_KEY=local
CLAUDE_CONTEXT_BASE_URL=http://127.0.0.1:1234/v1
CLAUDE_CONTEXT_EMBEDDING_DIM=768
CLAUDE_CONTEXT_MILVUS_ADDRESS=127.0.0.1:19530
CLAUDE_CONTEXT_MILVUS_TOKEN=
CLAUDE_CONTEXT_CUSTOM_EXTENSIONS=.vue,.svelte,.ts,.tsx

# ── Slack MCP ────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-...
SLACK_TEAM_ID=T...

# ── GitHub MCP ──────────────────────────────────────────────────
GITHUB_TOKEN=ghp_...

# ── Linear MCP ──────────────────────────────────────────────────
LINEAR_API_KEY=lin_api_...

# ── Jira MCP ────────────────────────────────────────────────────
JIRA_TOKEN=...

# ── AnySearch MCP ───────────────────────────────────────────────
# 申請：AnySearch console；格式 as_sk_...
ANYSEARCH_API_KEY=as_sk_...
