# ── 工具函式（模組共用）──────────────────────────────────────────
_command_exists() { command -v "$1" &>/dev/null; }
_safe_source()    { [[ -s "$1" ]] && source "$1"; }

# ── 標準使用者二進制路徑 ─────────────────────────────────────────
# ~/.local/bin: Claude Code 官方安裝器、pipx、cargo install 等
[[ -d "$HOME/.local/bin" ]] && export PATH="$HOME/.local/bin:$PATH"

# ── Homebrew（硬編碼路徑，省 ~200ms 的 brew --prefix 調用）────────
if [[ -d "/opt/homebrew" ]]; then
  export BREW_PREFIX="/opt/homebrew"
elif [[ -d "/usr/local/Cellar" ]]; then
  export BREW_PREFIX="/usr/local"
else
  export BREW_PREFIX="/usr/local"
fi

# ── pyenv（lazy load，省 ~300ms）──────────────────────────────────
if [[ -d "$HOME/.pyenv" ]]; then
  export PYENV_ROOT="$HOME/.pyenv"
  [[ ":$PATH:" != *":$PYENV_ROOT/bin:"* ]] && export PATH="$PYENV_ROOT/bin:$PATH"

  pyenv() {
    unset -f pyenv python python3 pip pip3 2>/dev/null
    eval "$(command pyenv init - zsh)"
    pyenv "$@"
  }
  python()  { unset -f python;  eval "$(command pyenv init - zsh)"; python  "$@"; }
  python3() { unset -f python3; eval "$(command pyenv init - zsh)"; python3 "$@"; }
fi

# ── 動態載入 ~/.zsh/modules/ 所有模組（字母順序）────────────────
# 載入順序：aliases → completion → fzf → git → history →
#           keybindings → nvm → plugins → pnpm → tools
for _zsh_module in ~/.zsh/modules/*.zsh(N); do
  source "$_zsh_module"
done
unset _zsh_module

# ── 個人設定（不會被 ab-tao 覆蓋）────────────────────────
# 環境變數、PATH、alias 等個人設定請放在 ~/.zshrc.local
[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"
