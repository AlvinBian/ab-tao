[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	light = false
	side-by-side = true
	line-numbers = true

[merge]
	conflictstyle = diff3

[diff]
	colorMoved = default

[alias]
	co    = checkout
	ci    = commit
	st    = status
	pl    = pull
	ps    = push
	dt    = difftool
	l     = log --stat
	cp    = cherry-pick
	ca    = commit -a
	b     = branch
	ss    = status --short --branch
	d     = diff
	ds    = diff --staged
	lg    = log --oneline --graph --decorate --all
	ll    = log --pretty=format:\"%C(yellow)%h%Creset %C(blue)%ad%Creset %s %C(green)[%an]%Creset\" --date=short
	a     = add
	aa    = add --all
	c     = commit -m
	amend = commit --amend
	cb    = checkout -b
	ba    = branch -a
	pf    = push --force-with-lease
	plr   = pull --rebase
