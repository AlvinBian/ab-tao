{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "ab-tao:state:intent-cache",
	"title": "Intent Cache",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"version": {
			"type": "string",
			"description": "intent cache 格式版本"
		},
		"hitCount": {
			"type": "integer",
			"minimum": 0,
			"default": 0,
			"description": "快取命中次數"
		},
		"missCount": {
			"type": "integer",
			"minimum": 0,
			"default": 0,
			"description": "快取未命中次數"
		},
		"lastUpdatedAt": {
			"type": ["string", "null"],
			"format": "date-time",
			"description": "最後更新時間"
		}
	}
}
