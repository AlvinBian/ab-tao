{
  "name": "ab-tao",
  "private": true,
  "description": "ab-tao: 統一 monorepo — dotfiles 環境管理 + 共用資源庫",
  "type": "module",
  "packageManager": "pnpm@9.15.5",
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "scripts": {
    "help": "node scripts/help.mjs",

    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "check:ci": "biome check .",
    "clean": "turbo clean && rm -rf node_modules",

    "d:setup": "pnpm --filter @ab-tao/dotfiles run setup",
    "d:scan": "pnpm --filter @ab-tao/dotfiles run scan",
    "d:doctor": "pnpm --filter @ab-tao/dotfiles run doctor",
    "d:status": "pnpm --filter @ab-tao/dotfiles run status",
    "d:report": "pnpm --filter @ab-tao/dotfiles run report",
    "d:restore": "pnpm --filter @ab-tao/dotfiles run restore",
    "d:hooks": "pnpm --filter @ab-tao/dotfiles run hooks",
    "d:uninstall": "pnpm --filter @ab-tao/dotfiles run uninstall",

    "c:sync": "pnpm --filter @ab-tao/commons run sync",
    "c:sync:select": "pnpm --filter @ab-tao/commons run sync -- --select",
    "c:sync:all": "pnpm --filter @ab-tao/commons run sync -- --all",
    "c:validate": "pnpm --filter @ab-tao/commons run validate",

    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm run build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@changesets/cli": "^2.29.0",
    "turbo": "^2.0.0"
  }
}
