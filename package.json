{
  "name": "ab-tao",
  "type": "module",
  "version": "1.3.1",
  "private": true,
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "description": "ab-tao: Claude Code 智能環境管理 monorepo — Slack 區塊化輸出、Hooks、Skills、AI 資源同步",
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "scripts": {
    "help": "node scripts/help.mjs",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "eslint --fix .",
    "check": "turbo run lint",
    "check:ci": "turbo run lint",
    "clean": "turbo clean && rm -rf node_modules",
    "d:setup": "pnpm -C apps/dotfiles run setup",
    "d:status": "pnpm -C apps/dotfiles run status",
    "d:hooks": "pnpm -C apps/dotfiles run hooks",
    "d:uninstall": "pnpm -C apps/dotfiles run uninstall",
    "d:prefs-sync": "pnpm -C apps/dotfiles run prefs-sync",
    "d:restore": "pnpm -C apps/dotfiles run restore",
    "d:scan": "pnpm -C apps/dotfiles run scan",
    "d:chrome": "pnpm -C apps/dotfiles run chrome",
    "d:doctor": "pnpm -C apps/dotfiles run doctor",
    "d:profile": "node apps/dotfiles/bin/profile.mjs",
    "c:ai-sync": "pnpm -C packages/commons run ai-sync",
    "c:skills": "pnpm -C packages/commons run skills",
    "c:skills:curated": "node apps/dotfiles/bin/skills-curated.mjs",
    "c:validate": "pnpm -C packages/commons run validate",
    "c:translate": "pnpm -C packages/commons run translate",
    "c:locals": "pnpm -C packages/commons run locals",
    "c:plugin": "node apps/dotfiles/bin/plugin-audit.mjs --audit",
    "c:metrics": "node apps/dotfiles/bin/metrics-report.mjs",
    "c:memory": "node apps/dotfiles/bin/memory-lint.mjs --lint",
    "c:memory:federated": "node apps/dotfiles/bin/memory-federated.mjs",
    "c:failure-patterns": "node apps/dotfiles/bin/failure-patterns.mjs",
    "docs:audit": "node apps/dotfiles/scripts/docs-audit.mjs",
    "quickstart:smoke-test": "echo 'quickstart smoke test — not yet implemented'",
    "cs:dev": "pnpm -C apps/console run dev",
    "cs:build": "pnpm -C apps/console run build",
    "cs:open": "pnpm -C apps/console run build && pnpm -C apps/console run open",
    "cs:serve": "pnpm -C apps/console run serve",
    "cs:test": "cd apps/console && pnpm run test",
    "cs:demo": "node apps/dotfiles/scripts/demo-data.mjs",
    "changeset": "changeset add",
    "changeset:status": "changeset status",
    "version": "changeset version",
    "release": "changeset tag && git push --follow-tags",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@changesets/cli": "^2.29.0",
    "eslint": "^10.4.0",
    "lefthook": "^2.1.5",
    "turbo": "^2.0.0"
  }
}
