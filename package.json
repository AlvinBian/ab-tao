{
	"name": "ab-tao",
	"version": "1.0.0",
	"private": true,
	"description": "ab-tao: 統一 monorepo — dotfiles 環境管理 + 共用資源庫",
	"type": "module",
	"packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
	"engines": {
		"node": ">=18",
		"pnpm": ">=9"
	},
	"scripts": {
		"help": "node scripts/help.mjs",
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "turbo run lint",
		"test": "turbo run test",
		"format": "biome format --write .",
		"check": "biome check --write .",
		"check:ci": "biome check .",
		"clean": "turbo clean && rm -rf node_modules",
		"d:setup": "pnpm -C apps/dotfiles run setup",
		"d:status": "pnpm -C apps/dotfiles run status",
		"d:hooks": "pnpm -C apps/dotfiles run hooks",
		"d:uninstall": "pnpm -C apps/dotfiles run uninstall",
		"d:prefs-sync": "pnpm -C apps/dotfiles run prefs-sync",
		"d:restore": "pnpm -C apps/dotfiles run restore",
		"d:scan": "pnpm -C apps/dotfiles run scan",
		"d:report": "pnpm -C apps/dotfiles run report",
		"c:ai-sync": "pnpm -C packages/commons run ai-sync",
		"c:skills": "pnpm -C packages/commons run skills",
		"c:validate": "pnpm -C packages/commons run validate",
		"c:translate": "pnpm -C packages/commons run translate",
		"changeset": "changeset add",
		"changeset:status": "changeset status",
		"version": "changeset version",
		"release": "changeset tag && git push --follow-tags",
		"prepare": "lefthook install"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"lefthook"
		]
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.10",
		"@changesets/cli": "^2.29.0",
		"lefthook": "^2.1.5",
		"turbo": "^2.0.0"
	}
}
