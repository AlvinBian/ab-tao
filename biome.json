{
	"$schema": "https://biomejs.dev/schemas/2.4.10/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**",
			"!node_modules",
			"!dist",
			"!**/dist",
			"!build",
			"!.turbo",
			"!.cache",
			"!**/resources",
			"!ecc",
			"!docs",
			"!apps/cheatsheet/index.html"
		]
	}
}
